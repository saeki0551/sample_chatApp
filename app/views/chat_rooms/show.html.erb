<p>Chatroomへようこそ!</p>
<p>あなた：<%= current_user.email %></p>
<p>お相手：<%= @chat_room_user.email %>さん</p>
<%# <p>ブロックしたユーザー：<%= @blocked_user.id %></p> 

<% @chat_messages.each do |chat_message| %>
  <% if @blocked_user.present? %>
    <% if chat_message.block_judgment == true && current_user.id != @blocked_user.id %>
      <%# 非表示メッセージ %>
    <% else %>
      <hr>
      <div>
        <li>内容：<%= chat_message.content %></li>
        <li><%= chat_message.created_at %>に送信済み</li>
        <li><%= chat_message.user.email%>さんのメッセージ</li>
        <li>判定：<%= chat_message.block_judgment %>さんのメッセージ</li>
      </div>
      <hr>
    <% end %>
  <% else %>
    <hr>
    <div>
      <li>内容：<%= chat_message.content %></li>
      <li><%= chat_message.created_at %>に送信済み</li>
      <li><%= chat_message.user.email%>さんのメッセージ</li>
      <li>判定：<%= chat_message.block_judgment %>さんのメッセージ</li>
    </div>
    <hr>
  <% end %>
<% end %>

<%= form_with model: @chat_message do |f| %>
    <%= f.hidden_field :chat_room_id, value: @chat_room.id %>
    <% if @blocked_user.present? %>
    <%= f.hidden_field :blocked_chat_message_id, value: @chat_message.id %>
    <% end %>
    <%= f.text_area :content %>
    <%= f.submit %>
<% end %>