<p><%= @group.name %> のグループチャット</p>

<p>このグループのユーザー一覧</p>
<ul>
    <% @group_users.each do |group_user| %>
      <li><%= link_to group_user.user.email, user_path(group_user.user.id) %></li>
    <% end %>
</ul>

<% @chat_messages.each do |chat_message| %>
        <hr>
        <div>
            <li>内容：<%= chat_message.content %></li>
            <li><%= chat_message.created_at %>に送信済み</li>
            <li><%= chat_message.user.email%>さんのメッセージ</li>
        </div>
        <hr>
<% end %>

<%= form_with model: @chat_message do |f| %>
    <%= f.hidden_field :group_id, value: @group.id %>
    <% @group_user_ids.each do |group_user_id| %>
      <%= f.hidden_field :group_user_ids, multiple: true, value: group_user_id.id %>
    <% end %>
    <%= f.text_area :content %>
    <%= f.submit %>
<% end %>